# --workspace points at a real root:root 0755 tree under /opt (see
# install_twin.sh) holding just this node's real children's own
# hydra-umc.project.json files - same real permission lesson learned
# installing HYDRA-UMC-VISION-NODE (a symlink to the real sibling-repo
# checkout root would be unreadable by this service's own unprivileged
# account, since that root lives under the operator's home directory,
# 0700 by Debian's own default).
[Unit]
Description=HYDRA-UMC-TWIN real family-status/family-sync API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-twin
Group=hydra-umc-twin
WorkingDirectory=/opt/hydra-umc/twin
ExecStart=/opt/hydra-umc/twin/hydra-umc-twin serve --addr 127.0.0.1 --port 8111 --workspace /opt/hydra-umc/twin/workspace
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# C13: a real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryAccounting=yes
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
